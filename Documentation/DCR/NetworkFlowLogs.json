{
    "location": "<la-workspace-region>",
    "properties": {
        "dataSources": {
            "extensions": [
                {
                    "streams": [
                        "Microsoft-NetworkFlowLogs"
                    ],
                    "extensionName": "AzureMonitorNetworkFlowLogsExtension",
                    "extensionSettings": {
                        "filterSettings": {
                            "namespace": "<source or destination k8s namespace>",
                            "verdict":  "<verdict of the flow>",
                            "workload": "<name of the k8s workload>",
                            "flowType" : "<type of flow>",
                            "Layer4Protocol": "<name of the Layer4Protocol>",
                            "SourcePort": "<source port>",
                            "DestinationPort": "<destination port>"
                        }
                    },
                    "name": "AzureMonitorNetworkFlowLogsExtension"
                }
            ]
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "/subscriptions/<subscriptionId>/resourcegroups/<rgName>/providers/microsoft.operationalinsights/workspaces/<workspaceName>",
                    "name": "la-workspace"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [
                    "Microsoft-NetworkFlowLogs"
                ],
                "transformKql": "source | where Layer4Protocol in ('TCP', 'UDP')",
                "destinations": [
                    "la-workspace"
                ]
            }
        ]
    }
}
