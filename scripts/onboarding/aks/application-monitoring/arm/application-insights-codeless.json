{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "applicationInsightsName": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Name of the Application Insights component."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the resources."
      }
    },
    "createLogAnalyticsWorkspace": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Create the Log Analytics workspace in this deployment."
      }
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "defaultValue": "app-monitoring-law",
      "metadata": {
        "description": "Name of the Log Analytics workspace when createLogAnalyticsWorkspace is true."
      }
    },
    "logAnalyticsWorkspaceResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of an existing Log Analytics workspace when createLogAnalyticsWorkspace is false."
      }
    },
    "workspaceRetentionInDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 30,
      "maxValue": 730,
      "metadata": {
        "description": "Log Analytics workspace retention in days."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    }
  },
  "variables": {
    "effectiveLogAnalyticsWorkspaceResourceId": "[if(parameters('createLogAnalyticsWorkspace'), resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName')), parameters('logAnalyticsWorkspaceResourceId'))]"
  },
  "resources": [
    {
      "condition": "[parameters('createLogAnalyticsWorkspace')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2025-07-01",
      "name": "[parameters('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": "[parameters('workspaceRetentionInDays')]"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('applicationInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
      ],
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[variables('effectiveLogAnalyticsWorkspaceResourceId')]",
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    }
  ],
  "outputs": {
    "applicationInsightsResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/components', parameters('applicationInsightsName'))]"
    },
    "logAnalyticsWorkspaceResourceId": {
      "type": "string",
      "value": "[variables('effectiveLogAnalyticsWorkspaceResourceId')]"
    }
  }
}
