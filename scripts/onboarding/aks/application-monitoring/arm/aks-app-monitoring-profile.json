{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "clusterName": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Name of the existing AKS cluster. Deploy this template to the cluster resource group."
      }
    },
    "clusterLocation": {
      "type": "string",
      "metadata": {
        "description": "Azure region of the AKS cluster."
      }
    },
    "autoInstrumentationEnabled": {
      "type": "bool",
      "metadata": {
        "description": "Enable or disable autoinstrumentation."
      }
    },
    "openTelemetryMetricsEnabled": {
      "type": "bool",
      "metadata": {
        "description": "Enable or disable the vendor-neutral OpenTelemetry metrics receiver."
      }
    },
    "openTelemetryMetricsHttpPort": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "maxValue": 65535,
      "metadata": {
        "description": "Optional HTTP/Protobuf host port. Use 0 to omit the property and use the service default. Ignored when the receiver is disabled."
      }
    },
    "openTelemetryMetricsGrpcPort": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "maxValue": 65535,
      "metadata": {
        "description": "Optional gRPC host port. Use 0 to omit the property and use the service default. Ignored when the receiver is disabled."
      }
    },
    "openTelemetryLogsAndTracesEnabled": {
      "type": "bool",
      "metadata": {
        "description": "Enable or disable the vendor-neutral OpenTelemetry logs and traces receiver."
      }
    },
    "openTelemetryLogsAndTracesHttpPort": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "maxValue": 65535,
      "metadata": {
        "description": "Optional HTTP/Protobuf host port. Use 0 to omit the property and use the service default. Ignored when the receiver is disabled."
      }
    },
    "openTelemetryLogsAndTracesGrpcPort": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "maxValue": 65535,
      "metadata": {
        "description": "Optional gRPC host port. Use 0 to omit the property and use the service default. Ignored when the receiver is disabled."
      }
    }
  },
  "variables": {
    "openTelemetryMetricsProfile": "[union(createObject('enabled', parameters('openTelemetryMetricsEnabled')), if(and(parameters('openTelemetryMetricsEnabled'), greater(parameters('openTelemetryMetricsHttpPort'), 0)), createObject('httpPort', parameters('openTelemetryMetricsHttpPort')), createObject()), if(and(parameters('openTelemetryMetricsEnabled'), greater(parameters('openTelemetryMetricsGrpcPort'), 0)), createObject('grpcPort', parameters('openTelemetryMetricsGrpcPort')), createObject()))]",
    "openTelemetryLogsAndTracesProfile": "[union(createObject('enabled', parameters('openTelemetryLogsAndTracesEnabled')), if(and(parameters('openTelemetryLogsAndTracesEnabled'), greater(parameters('openTelemetryLogsAndTracesHttpPort'), 0)), createObject('httpPort', parameters('openTelemetryLogsAndTracesHttpPort')), createObject()), if(and(parameters('openTelemetryLogsAndTracesEnabled'), greater(parameters('openTelemetryLogsAndTracesGrpcPort'), 0)), createObject('grpcPort', parameters('openTelemetryLogsAndTracesGrpcPort')), createObject()))]",
    "appMonitoringProfile": "[createObject('autoInstrumentation', createObject('enabled', parameters('autoInstrumentationEnabled')), 'openTelemetryMetrics', variables('openTelemetryMetricsProfile'), 'openTelemetryLogsAndTraces', variables('openTelemetryLogsAndTracesProfile'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2026-06-01",
      "name": "[parameters('clusterName')]",
      "location": "[parameters('clusterLocation')]",
      "properties": {
        "azureMonitorProfile": {
          "appMonitoring": "[variables('appMonitoringProfile')]"
        }
      }
    }
  ],
  "outputs": {
    "clusterResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]"
    },
    "configuredAppMonitoringProfile": {
      "type": "object",
      "value": "[variables('appMonitoringProfile')]"
    }
  }
}
