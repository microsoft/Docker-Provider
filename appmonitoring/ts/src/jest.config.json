{
  "verbose": true,
  "preset": "ts-jest",
  "transform": {
    ".*": [
      "ts-jest",
      {
        "isolatedModules": true
      }
    ]
  },
  "transformIgnorePatterns": [],
  "testEnvironment": "node",
  "testRegex": "tests/.*\\.spec\\.ts$",
  "moduleDirectories": ["node_modules", "<rootDir>", "out"],
  "moduleFileExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "json",
    "node"
  ]
}